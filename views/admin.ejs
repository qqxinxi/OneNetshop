<%- include('partials/header', { title: title || '后台管理' }) %>

<main class="page-wrap">
  <div class="container admin-layout">
    <h1>后台管理</h1>

    <section class="admin-panel">
      <h2>新增商品</h2>
      <form action="/admin/add" method="POST" enctype="multipart/form-data" class="admin-form">
        <input type="text" name="title" placeholder="商品标题" required />
        <input type="number" step="0.01" name="price" placeholder="价格" required />
        <textarea name="description" placeholder="商品描述"></textarea>
        <input type="file" name="image" accept="image/*" />
        <button type="submit" class="primary-btn">添加商品</button>
      </form>
    </section>

    <section class="admin-panel">
      <h2>商品列表</h2>
      <div class="admin-list">
        <% products.forEach((product) => { %>
          <div class="admin-item">
            <div>
              <strong><%= product.title %></strong>
              <span>￥<%= Number(product.price).toFixed(2) %></span>
            </div>
            <form action="/admin/remove/<%= product._id %>" method="POST">
              <button type="submit" class="remove-btn">删除</button>
            </form>
          </div>
        <% }) %>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
